#!name=xke AI Routing - Test
#!desc=Phase 3: ChatGPT and Gemini routing through a selectable personal proxy group. Keep existing rules and ad blocking.

[Proxy Group]
AI-PROXY = select,Tencent-US-Direct,Tencent-US

[Rule]
# Compatibility probe (kept from Phase 2)
DOMAIN,example.org,AI-PROXY

# OpenAI / ChatGPT
DOMAIN-SUFFIX,chatgpt.com,AI-PROXY
DOMAIN-SUFFIX,openai.com,AI-PROXY
DOMAIN-SUFFIX,oaistatic.com,AI-PROXY
DOMAIN-SUFFIX,oaiusercontent.com,AI-PROXY

# Google Gemini / AI Studio (specific hosts only)
DOMAIN,gemini.google.com,AI-PROXY
DOMAIN,aistudio.google.com,AI-PROXY
DOMAIN,ai.google.dev,AI-PROXY
DOMAIN,generativelanguage.googleapis.com,AI-PROXY

# Google AI developer tools / Antigravity (specific hosts only)
DOMAIN,aida.googleapis.com,AI-PROXY
DOMAIN,daily-cloudcode-pa.googleapis.com,AI-PROXY
DOMAIN-SUFFIX,antigravity.google,AI-PROXY
DOMAIN-SUFFIX,antigravity-unleash.goog,AI-PROXY
